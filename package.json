{
  "name": "gulp-rev-rewrite",
  "version": "7.0.0",
  "description": "Rewrite references to assets that have been revisioned using gulp-rev",
  "license": "MIT",
  "repository": "thomasvantuycom/gulp-rev-rewrite",
  "author": {
    "name": "Thomas Vantuycom",
    "email": "thomasvantuycom@proton.me",
    "url": "https://www.thomasvantuycom.com"
  },
  "type": "module",
  "exports": "./index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "xo && node --test \"test/!(_*).js\""
  },
  "files": [
    "index.js",
    "lib"
  ],
  "keywords": [
    "asset",
    "assets",
    "gulpplugin",
    "replace",
    "rev",
    "revision",
    "revving",
    "rewrite",
    "version",
    "versioning"
  ],
  "dependencies": {
    "plugin-error": "^2.0.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "semantic-release": "^26.0.1",
    "vinyl": "^3.0.1",
    "xo": "^4.0.0"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "message": "release: ${nextRelease.version}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "xo": {
    "rules": {
      "markdown/no-multiple-h1": "off"
    }
  }
}
